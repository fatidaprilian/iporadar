# Environment
ENVIRONMENT=development
PORT=8000

# Database
# Default to PostgreSQL in docker-compose
DATABASE_URL=postgresql://iporadar_readonly:iporadar_dev@localhost:5432/iporadar

# To use SQLite locally instead:
# DATABASE_URL=sqlite:///./iporadar.db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
