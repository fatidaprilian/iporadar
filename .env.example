# IPO Radar - Environment Variables
# Copy this file to .env and fill in the values

# --- PostgreSQL ---
POSTGRES_USER=iporadar
POSTGRES_PASSWORD=iporadar_dev
POSTGRES_DB=iporadar
DATABASE_URL=postgresql://iporadar:iporadar_dev@postgres:5432/iporadar

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- NestJS API ---
NODE_ENV=development
API_PORT=3001
ML_SERVICE_URL=http://ml-service:8000

# --- ML Service ---
ENVIRONMENT=development
ML_PORT=8000
# Read-only database access for ML service
ML_DATABASE_URL=postgresql://iporadar_readonly:iporadar_dev@postgres:5432/iporadar

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000
